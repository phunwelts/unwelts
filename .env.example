# unwelts — local dev environment
# Copy to .env and fill in values. Never commit .env to version control.

APP_ENV=development
DEBUG=false

DATABASE_URL=postgresql+asyncpg://unwelts:unwelts@localhost:5432/unwelts
REDIS_URL=redis://localhost:6379/0

# At least 32 random characters. Generate with: openssl rand -hex 32
FINGERPRINT_SECRET=change-me-generate-with-openssl-rand-hex-32

# Optional — defaults shown
# Production: set to your domain, e.g. ["https://unwelts.com"]
CORS_ORIGINS=["http://localhost:3000"]

# Production only (Phase 5 — AWS)
# APP_ENV=production
# AWS_SECRET_NAME=unwelts/prod/secrets
# AWS_REGION=us-east-1
