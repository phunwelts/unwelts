# unwelts — local dev environment
# Copy to .env and fill in values. Never commit .env to version control.

APP_ENV=development
DEBUG=false

DATABASE_URL=postgresql+asyncpg://unwelts:unwelts@localhost:5432/unwelts
REDIS_URL=redis://localhost:6379/0

# At least 32 random characters. Generate with: openssl rand -hex 32
FINGERPRINT_SECRET=change-me-generate-with-openssl-rand-hex-32

# Optional — defaults shown
# Production: set to your domain, e.g. ["https://unwelts.com"]
CORS_ORIGINS=["http://localhost:3000"]

# Number of reverse proxies in front of the API (Fly edge, ALB, ...).
# 0 = ignore X-Forwarded-For (safe default when directly reachable).
# Production behind a single proxy: set to 1, or the IP rate limit keys on
# the proxy's address instead of the client's.
TRUSTED_PROXY_COUNT=0

# Production only (Phase 5 — AWS)
# APP_ENV=production
# AWS_SECRET_NAME=unwelts/prod/secrets
# AWS_REGION=us-east-1
